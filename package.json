{
  "name": "rockstar-newswire",
  "version": "2.2.0",
  "description": "Bring Rockstar Newswire news to Discord or RSS, with per-genre channels (GTA VI) and a JSONL event log.",
  "main": "src/poller.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "lint": "eslint ."
  },
  "keywords": [
    "news",
    "gtav",
    "rdr2",
    "rdr2-online",
    "gta-online",
    "RDR2O",
    "RDR2O-NEWS",
    "GTAO",
    "GTAO-NEWS",
    "newswire",
    "discord",
    "discord-webhook",
    "webhook",
    "discord-gtav",
    "discord-gtav-news",
    "discord-rdr2",
    "discord-rdr2-news",
    "rockstar-newswire",
    "rockstar-newswire-discord",
    "gta6",
    "gtavi",
    "grand-theft-auto-vi",
    "event-log"
  ],
  "author": "Carbowix & NightMean",
  "license": "MIT",
  "dependencies": {
    "feed": "^5.1.0",
    "js-yaml": "^4.1.1",
    "puppeteer": "^24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1"
  }
}
